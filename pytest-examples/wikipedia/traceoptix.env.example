# Copy to traceoptix.env and edit. Export explicitly; pytest does not load this file.
TRACEOPTIX_URL=https://traceoptix.example.com
TRACEOPTIX_TOKEN=td_replace_with_runs_write_token
TRACEOPTIX_PROJECT=wikipedia-search
TRACEOPTIX_ORG=your-org-slug
TRACEOPTIX_RUN_NAME='Wikipedia API and UI search'
TRACEOPTIX_ENVIRONMENT=sample
